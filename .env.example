# Copy to .env and fill in. Never commit .env.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, needed when served over HTTPS on a domain
CSRF_TRUSTED_ORIGINS=https://ims.example.com
SECURE_SSL_REDIRECT=False

# Database: SQLite by default. Set USE_POSTGRES=True and either DATABASE_URL or DB_*.
USE_POSTGRES=False
DATABASE_URL=
DB_NAME=ims
DB_USER=ims
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (renewal reminders, notifications). Console backend prints to terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@ims.local

# Token for the HTTP-triggered renewal check: /billing/cron/check-renewals/?token=...
CRON_SECRET=
